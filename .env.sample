# Root — copy to .env for Docker Compose variable substitution.
# Port values are defined in each workspace .env.sample; keep these in sync when changing ports.
#
#   packages/ui/.env.sample
#   apps/nestjs/.env.sample
#   apps/auth/.env.sample
#   apps/web/.env.sample

# Dev (local + compose dev)
WEB_PORT=3001
UI_PORT=3004
NESTJS_PORT=3006
AUTH_PORT=3007

# Postgres (nestjs control plane — docker-compose profile nestjs)
POSTGRES_USER=fivenines
POSTGRES_PASSWORD=fivenines
POSTGRES_DB=fivenines
POSTGRES_PORT=5432
# Host: 127.0.0.1 (IPv4). Compose overrides to postgres:5432 via docker-compose.dev.yml.
DATABASE_URL=postgresql://fivenines:fivenines@127.0.0.1:5432/fivenines

# Auth (@apps/auth — profile auth)
AUTH_ISSUER=http://localhost:3007
AUTH_AUDIENCE=fivenines-api
AUTH_AUDIENCE_EVAL=fivenines-eval
# Host: 127.0.0.1. In compose, docker-compose.dev.yml defaults to postgres:5432.
AUTH_DATABASE_URL=postgresql://fivenines:fivenines@127.0.0.1:5432/fivenines_auth
AUTH_SEED_ADMIN_EMAIL=admin@example.com
AUTH_SEED_ADMIN_PASSWORD=changeme

# Nest JWT verification (Phase 4 — point at auth JWKS)
AUTH_JWKS_URL=http://localhost:3007/.well-known/jwks.json
AUTH_ALLOW_HEADER_TENANT=true

# Browser origins for Nest CORS (player UI will use :3001)
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
