# Root — copy to .env for Docker Compose variable substitution.
# Port values are defined in each workspace .env.sample; keep these in sync when changing ports.
#
#   packages/ui/.env.sample
#   apps/nestjs/.env.sample
#   apps/auth/.env.sample
#   apps/web/.env.sample

# Dev (local + compose dev)
WEB_PORT=3001
UI_PORT=3004
NESTJS_PORT=3006
AUTH_PORT=3007

# Postgres credentials — shared.
# Dev compose postgres service uses these as-is.
# Dev compose nestjs/auth build DATABASE_URL from these + hostname `postgres`.
POSTGRES_USER=fivenines
POSTGRES_PASSWORD=fivenines
POSTGRES_DB=fivenines
POSTGRES_PORT=5432

# Host-only + production compose (`bun run container --prod` interpolates this as-is).
# Dev compose does not interpolate this; it builds the URL from POSTGRES_* + hostname `postgres`.
DATABASE_URL=postgresql://fivenines:fivenines@127.0.0.1:5432/fivenines

# Auth (@apps/auth — profile auth)
AUTH_ISSUER=http://auth.fivenines.com:3007
AUTH_AUDIENCE=fivenines-api
AUTH_AUDIENCE_EVAL=fivenines-eval
# Host-only: `cd apps/auth && bun run …` (see apps/auth/.env.sample).
# Dev compose does not interpolate this; inside the container `postgres` is the DB host.
AUTH_DATABASE_URL=postgresql://fivenines:fivenines@127.0.0.1:5432/fivenines_auth
AUTH_SEED_ADMIN_EMAIL=admin@example.com
AUTH_SEED_ADMIN_PASSWORD=changeme
AUTH_COOKIE_DOMAIN=.fivenines.com
AUTH_PLAY_ORIGIN=http://play.fivenines.com:3001
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_ACCESS=auth_access
AUTH_COOKIE_LOGGED_IN=was_logged_in

# Nest JWT verification (Phase 4 — point at auth JWKS)
AUTH_JWKS_URL=http://localhost:3007/.well-known/jwks.json
AUTH_ALLOW_HEADER_TENANT=true

# Browser origins for Nest CORS (player UI on play.fivenines.com)
ALLOWED_ORIGINS=http://play.fivenines.com:3001,http://localhost:3001,http://127.0.0.1:3001

# Player UI → auth hop (no Vite proxy). Login still sends allowlisted `redirect_uri`; auth 302s to `AUTH_PLAY_ORIGIN/hub`.
VITE_AUTH_URL=http://auth.fivenines.com:3007
VITE_APP_ORIGIN=http://play.fivenines.com:3001
VITE_NESTJS_API_URL=http://api.fivenines.com:3006
AUTH_REDIRECT_ORIGINS=http://play.fivenines.com:3001,http://localhost:3001,http://127.0.0.1:3001
