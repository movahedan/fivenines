# @apps/auth — copy to .env (see root .env.sample for compose substitution)
HOST=0.0.0.0
AUTH_PORT=3001
PORT=3001
NODE_ENV=development

AUTH_ISSUER=http://auth.fivenines.com:3001
AUTH_AUDIENCE=fivenines-api
AUTH_AUDIENCE_EVAL=fivenines-eval
AUTH_ACCESS_TTL_SECONDS=900

# Host `bun run` (this file). Postgres is published on localhost:5432.
# Compose auth container does not read this file for DB: it sets AUTH_DATABASE_URL
# to postgresql://USER:PASS@postgres:5432/fivenines_auth from root POSTGRES_*.
AUTH_DATABASE_URL=postgresql://fivenines:fivenines@localhost:5432/fivenines_auth

AUTH_COOKIE_SESSION=auth_session
AUTH_COOKIE_REFRESH=auth_refresh
AUTH_COOKIE_ACCESS=auth_access
AUTH_COOKIE_LOGGED_IN=was_logged_in
AUTH_COOKIE_CSRF=auth_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=.fivenines.com

# PEM strings or paths (dev: scripts/generate-dev-keys.ts writes dev-keys/*.pem)
AUTH_JWT_PRIVATE_KEY=./dev-keys/private.pem
AUTH_JWT_PUBLIC_KEY=./dev-keys/public.pem

# Seed credentials (db:seed)
AUTH_SEED_ADMIN_EMAIL=admin@example.com
AUTH_SEED_ADMIN_PASSWORD=changeme

# Self-service sign-up (default on in development, off in production)
AUTH_ALLOW_REGISTRATION=true
AUTH_ALLOW_OTP=true
# Log OTP codes to server console (dev only; no email provider yet)
AUTH_OTP_LOG=true
AUTH_OTP_TTL_MINUTES=10

# Player UI origins allowed as redirect_uri after login
AUTH_REDIRECT_ORIGINS=http://play.fivenines.com:3000,http://localhost:3000,http://127.0.0.1:3000
