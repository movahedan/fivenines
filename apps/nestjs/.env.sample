# @apps/nestjs — copy to .env (see root .env.sample for compose substitution)
HOST=0.0.0.0
NESTJS_PORT=3002
PORT=3002
ALLOWED_ORIGINS=http://play.fivenines.com:3000,http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
# Host `bun run` (this file). Postgres is published on localhost:5432.
# Compose nestjs container does not read this file for DB: it sets DATABASE_URL
# to postgresql://USER:PASS@postgres:5432/DB from root POSTGRES_*.
DATABASE_URL=postgresql://fivenines:fivenines@127.0.0.1:5432/fivenines

# JWT from @apps/auth. Same hostname as AUTH_ISSUER (hosts file locally).
# Dev compose Nest reaches JWKS via extra_hosts; prod compose uses service DNS `auth`.
AUTH_JWKS_URL=http://auth.fivenines.com:3001/.well-known/jwks.json
AUTH_ISSUER=http://auth.fivenines.com:3001
AUTH_AUDIENCE=fivenines-api
AUTH_ALLOW_HEADER_TENANT=true
AUTH_COOKIE_ACCESS=auth_access
