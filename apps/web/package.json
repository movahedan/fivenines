{
	"private": true,
	"name": "@apps/web",
	"type": "module",
	"version": "0.1.0",
	"description": "Five Nines player UI — TanStack Start SPA (static dist)",
	"scripts": {
		"dev": "bun --bun vite --host --port ${WEB_PORT:-3000}",
		"build": "vite build && bun run prerender",
		"prerender": "WEB_PRERENDER=1 bun scripts/prerender-web.ts",
		"export:check": "bun scripts/export-check-web.ts",
		"preview:static": "bunx serve dist/client -s -l ${WEB_PORT:-${PORT:-3000}}",
		"start": "bun run preview:static",
		"typecheck": "tsc --noEmit",
		"test": "bun --cwd ../.. test apps/web/src apps/web/scripts/web-prerender-paths.test.ts"
	},
	"dependencies": {
		"@packages/analytics": "workspace:*",
		"@packages/fivenines-engine": "workspace:*",
		"@packages/auth": "workspace:*",
		"@packages/http": "workspace:*",
		"@packages/nestjs-sdk": "workspace:*",
		"@packages/shared": "workspace:*",
		"@packages/shared-react": "workspace:*",
		"@packages/ui": "workspace:*",
		"@tanstack/history": "1.162.5",
		"@tanstack/react-query": "5.104.3",
		"@tanstack/react-router": "1.170.44",
		"@tanstack/react-start": "1.169.2",
		"@tanstack/router-core": "1.171.37",
		"eventsource-parser": "4.1.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-native-web": "0.21.4",
		"use-sync-external-store": "1.7.0",
		"workbox-window": "7.4.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@tools/tests-preset": "workspace:*",
		"@tools/typescript": "workspace:*",
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vite-plugin-pwa": "1.3.0"
	}
}
