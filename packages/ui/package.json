	"scripts": {
		"typecheck": "tsc --noEmit",
		"watch:exports": "bun --no-clear-screen --watch --preload ./test-rn-preload.ts ./scripts/watch-export-modules.ts",
		"dev": "bun run watch:exports & WATCH_PID=$!; bun run dev:storybook; kill \"$WATCH_PID\" 2>/dev/null || true",
		"dev:storybook": "bun scripts/dev-storybook.ts",
		"prebuild": "bun scripts/write-barrels.ts && bun ../../tools/scripts/export-modules/index.tsx update --quiet --css-pattern '^src/([^/]+\\.css)$'",
		"build:storybook": "bunx storybook build -o dist-storybook",
		"start": "bun run build:storybook && bunx --bun serve dist-storybook"
	},
